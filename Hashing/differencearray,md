# Python Code

```python
def range_update(n, queries):

    diff = [0] * n

    for l, r, val in queries:

        diff[l] += val

        if r + 1 < n:
            diff[r + 1] -= val

    arr = [0] * n

    arr[0] = diff[0]

    for i in range(1, n):
        arr[i] = arr[i - 1] + diff[i]

    return arr


queries = [
    (1, 3, 2),
    (2, 4, 3),
    (0, 2, -1)
]

print(range_update(5, queries))
```

Output

```
[-1,1,4,5,3]
```

